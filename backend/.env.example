# ===========================================
# Memory Passport - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./memory_passport.db

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM Provider (OpenAI-compatible: Alibaba Cloud DashScope / Qwen, OpenAI, Ollama, etc.) ---
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus

# --- Embedding Provider (OpenAI-compatible) ---
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MCP API Key (for external AI agents) ---
MCP_API_KEY=mcp-change-me-to-a-random-key
