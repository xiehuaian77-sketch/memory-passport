# ===========================================
# Memory Passport - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./memory_passport.db

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM Provider (OpenAI-compatible: Alibaba Cloud DashScope / Qwen, OpenAI, Ollama, etc.) ---
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus

# --- Embedding Provider (OpenAI-compatible: Alibaba Cloud DashScope / Qwen, OpenAI, etc.) ---
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY can be left blank to reuse LLM_API_KEY
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MCP API Key (for external AI agents) ---
MCP_API_KEY=mcp-change-me-to-a-random-key
